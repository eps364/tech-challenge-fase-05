{
  "realm": "sus-connect",
  "enabled": true,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "api-gateway",
      "name": "API Gateway",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8761/*",
        "http://api-gateway:8761/*"
      ],
      "webOrigins": [
        "*"
      ]
    },
    {
      "clientId": "auth-service",
      "name": "Auth Service",
      "enabled": true,
      "publicClient": false,
      "secret": "auth-service-secret",
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://auth-service:8080/*"
      ]
    },
    {
      "clientId": "triage-service",
      "name": "Triage Service",
      "enabled": true,
      "publicClient": false,
      "secret": "triage-service-secret",
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "appointment-service",
      "name": "Appointment Service",
      "enabled": true,
      "publicClient": false,
      "secret": "appointment-service-secret",
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "medical-record-service",
      "name": "Medical Record Service",
      "enabled": true,
      "publicClient": false,
      "secret": "medical-record-service-secret",
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "frontend-client",
      "name": "Frontend Client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "*"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Default user role",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "admin",
        "description": "Administrator role",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "professional",
        "description": "Healthcare professional role",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "patient",
        "description": "Patient role",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "SUS",
      "email": "admin@sus-connect.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin"
        }
      ],
      "realmRoles": ["admin", "user"]
    },
    {
      "username": "patient01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "João",
      "lastName": "Silva",
      "email": "patient01@sus-connect.local",
      "credentials": [
        {
          "type": "password",
          "value": "patient123"
        }
      ],
      "realmRoles": ["patient", "user"]
    },
    {
      "username": "doctor01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Maria",
      "lastName": "Santos",
      "email": "doctor01@sus-connect.local",
      "credentials": [
        {
          "type": "password",
          "value": "doctor123"
        }
      ],
      "realmRoles": ["professional", "user"]
    }
  ]
}

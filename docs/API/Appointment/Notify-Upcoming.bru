meta {
  name: Notify Upcoming
  type: http
  seq: 9
}

post {
  url: {{appointmentBaseUrl}}/api/v1/appointments/notifications/reminders?hoursAhead=72
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 200) {
    console.log("Appointments notified: " + res.body.length);
  }
}

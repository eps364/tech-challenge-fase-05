meta {
  name: List Offers By Patient
  type: http
  seq: 6
}

get {
  url: {{appointmentBaseUrl}}/api/v1/appointments/offers?patientId={{futurePatientId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 200) {
    console.log("Offers found: " + res.body.length);
  }
}

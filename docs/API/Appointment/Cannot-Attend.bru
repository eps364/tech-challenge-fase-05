meta {
  name: Cannot Attend
  type: http
  seq: 5
}

patch {
  url: {{appointmentBaseUrl}}/api/v1/appointments/{{appointmentId}}/cannot-attend
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "reason": "Paciente informou que nao conseguira comparecer."
  }
}

script:post-response {
  if (res.status === 200 && res.body.generatedOffer) {
    bru.setEnvVar("offerId", res.body.generatedOffer.id);
    console.log("Offer generated: " + res.body.generatedOffer.id);
  }
}

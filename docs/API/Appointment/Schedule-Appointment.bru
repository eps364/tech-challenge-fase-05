meta {
  name: Schedule Appointment
  type: http
  seq: 1
}

post {
  url: {{appointmentBaseUrl}}/api/v1/appointments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "triageId": "{{triageId}}",
    "patientId": "{{patientId}}",
    "dateTime": "2026-06-10T10:00:00"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("appointmentId", res.body.id);
    console.log("Appointment scheduled with ID: " + res.body.id + " — status: " + res.body.status);
  }
}

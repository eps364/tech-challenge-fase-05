meta {
  name: Schedule Appointment
  type: http
  seq: 1
}

post {
  url: {{appointmentBaseUrl}}/api/v1/appointments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "patientId": "{{patientId}}",
    "professionalId": "99999999-9999-9999-9999-999999999991",
    "dateTime": "2026-07-10T10:00:00",
    "appointmentType": "EXAM",
    "serviceName": "Hemograma completo",
    "facilityName": "UBS Central",
    "preparationNotes": "Jejum de 8 horas. Beber agua normalmente."
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("appointmentId", res.body.id);
    console.log("Appointment scheduled with ID: " + res.body.id + " - status: " + res.body.status);
  }
}

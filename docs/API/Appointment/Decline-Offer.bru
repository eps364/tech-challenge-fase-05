meta {
  name: Decline Offer
  type: http
  seq: 8
}

patch {
  url: {{appointmentBaseUrl}}/api/v1/appointments/offers/{{offerId}}/decline
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 200) {
    console.log("Offer declined: " + res.body.id);
  }
}

meta {
  name: Accept Offer
  type: http
  seq: 7
}

patch {
  url: {{appointmentBaseUrl}}/api/v1/appointments/offers/{{offerId}}/accept
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 200) {
    console.log("Offer accepted: " + res.body.id);
  }
}

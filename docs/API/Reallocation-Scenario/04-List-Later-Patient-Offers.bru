meta {
  name: 04 List Later Patient Offers
  type: http
  seq: 4
}

get {
  url: {{appointmentBaseUrl}}/api/v1/appointments/offers?patientId={{scenarioLaterPatientId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 200) {
    console.log("Pending offers for later patient: " + res.body.length);
  }
}

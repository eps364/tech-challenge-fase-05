meta {
  name: 03 Closer Cannot Attend
  type: http
  seq: 3
}

patch {
  url: {{appointmentBaseUrl}}/api/v1/appointments/{{scenarioAppointmentId}}/cannot-attend
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "reason": "Paciente do horario mais proximo informou que nao conseguira comparecer."
  }
}

script:post-response {
  if (res.status === 200 && res.body.generatedOffer) {
    bru.setEnvVar("scenarioOfferId", res.body.generatedOffer.id);
    console.log("Offer generated: " + res.body.generatedOffer.id);
  }
}

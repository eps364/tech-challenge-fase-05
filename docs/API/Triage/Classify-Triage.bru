meta {
  name: Classify Triage
  type: http
  seq: 3
}

patch {
  url: {{triageBaseUrl}}/api/v1/triage/{{triageId}}/classify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "riskLevel": "YELLOW"
  }
}

script:post-response {
  if (res.status === 200) {
    console.log("Triage " + res.body.id + " classified as: " + res.body.riskLevel);
  }
}

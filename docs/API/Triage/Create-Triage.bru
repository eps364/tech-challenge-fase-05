meta {
  name: Create Triage
  type: http
  seq: 1
}

post {
  url: {{triageBaseUrl}}/api/v1/triage
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 201) {
    console.log("Triage created successfully with status 201");
  }
}

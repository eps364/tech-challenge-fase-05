meta {
  name: Create Triage
  type: http
  seq: 1
}

post {
  url: {{triageBaseUrl}}/api/v1/triage
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "patientId": "{{patientId}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("triageId", res.body.id);
    console.log("Triage created with ID: " + res.body.id + " — riskLevel: " + res.body.riskLevel);
  }
}

meta {
  name: Get Medical Record By Id
  type: http
  seq: 2
}

get {
  url: {{medicalRecordBaseUrl}}/api/v1/medical-records/{{medicalRecordId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 200) {
    console.log("Medical record found: " + res.body.id);
  }
}

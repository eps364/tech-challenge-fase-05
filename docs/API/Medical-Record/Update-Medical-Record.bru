meta {
  name: Update Medical Record
  type: http
  seq: 3
}

patch {
  url: {{medicalRecordBaseUrl}}/api/v1/medical-records/{{medicalRecordId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "diagnosis": "Acute pharyngitis — updated",
    "prescription": "Azithromycin 500mg once daily for 3 days",
    "consultationDate": "2026-06-10T11:00:00"
  }
}

script:post-response {
  if (res.status === 200) {
    console.log("Medical record " + res.body.id + " updated");
  }
}

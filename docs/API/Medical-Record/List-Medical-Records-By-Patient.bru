meta {
  name: List Medical Records By Patient
  type: http
  seq: 4
}

get {
  url: {{medicalRecordBaseUrl}}/api/v1/medical-records?patientId={{patientId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 200) {
    console.log("Medical records found: " + res.body.length);
  }
}

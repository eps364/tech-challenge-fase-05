meta {
  name: Logout
  type: http
  seq: 4
}

post {
  url: {{authBaseUrl}}/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 200) {
    console.log("User logged out successfully");
    bru.deleteEnvVar("accessToken");
    bru.deleteEnvVar("refreshToken");
  }
}

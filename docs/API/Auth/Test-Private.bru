meta {
  name: Test Private
  type: http
  seq: 6
}

get {
  url: {{authBaseUrl}}/auth/test/private
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 200) {
    const username = res.body.substring(res.body.indexOf("Hello ") + 6, res.body.indexOf("!"));
    console.log("Authenticated as: " + username);
  }
}

%% Arquitetura Geral - SUS-Connect APS MVP (Fase 05)

graph TD
    Coordinator["👤 Coordenador de APS"] -->|"Requisições HTTP REST"| API["REST API\n/api/v1"]
    ACS["👤 ACS / Equipe ESF"] -->|"Atualiza progresso agregado"| API

    subgraph Docker ["🐳 Docker Compose"]
        subgraph Service ["aps-prioritization-service\n(Java 21 · Spring Boot 3.4.5 · Porta 8205)"]
            subgraph Web ["infra/web"]
                Controller["ApsPrioritizationController"]
                ExcHandler["ApsExceptionHandler\n(ProblemDetail)"]
            end
            subgraph UseCases ["core/usecase"]
                UC1["GetDashboardUseCase"]
                UC2["ListTerritoriesUseCase"]
                UC3["GetTerritoryDetailsUseCase"]
                UC4["CreateTerritoryUseCase"]
                UC5["ReplaceTerritoryIndicatorsUseCase"]
                UC6["CreateSearchActionUseCase"]
                UC7["UpdateSearchActionProgressUseCase"]
            end
            subgraph Domain ["core/domain"]
                Territory["Territory"]
                SearchAction["SearchAction"]
                PriorityCalc["PriorityCalculator"]
                Enums["PriorityLevel\nPreventiveFocus\nActionStatus"]
            end
            subgraph Gateways ["core/gateway (interfaces)"]
                TGW["TerritoryGateway"]
                SGW["SearchActionGateway"]
            end
            subgraph Infra ["infra/gateway + infra/repository"]
                TAdapter["TerritoryRepositoryAdapter"]
                SAdapter["SearchActionRepositoryAdapter"]
                TRepo["TerritoryJpaRepository"]
                SRepo["SearchActionJpaRepository"]
            end
            subgraph Config ["infra/config"]
                Demo["DemoDataConfig\n(APS_DEMO_DATA_ENABLED)"]
                Props["ApsPriorityProperties\n(APS_LINKAGE_TARGET)"]
            end
        end

        DB[("🐘 PostgreSQL 15\naps_priority_db\nPorta 5434")]
    end

    API --> Controller
    Controller --> UC1 & UC2 & UC3 & UC4 & UC5 & UC6 & UC7
    UC1 & UC2 & UC3 & UC4 & UC5 & UC6 & UC7 --> TGW & SGW
    TGW --> TAdapter --> TRepo --> DB
    SGW --> SAdapter --> SRepo --> DB
    UC3 --> PriorityCalc
    PriorityCalc --> Territory & Enums
    Domain -.->|"Plain Java, sem frameworks"| Domain
    Flyway["🗃️ Flyway Migrations\n(schema versionado)"] --> DB

    Swagger["📄 Swagger UI\nlocalhost:8205/swagger-ui"] -.-> API
    Health["❤️ Actuator Health\nlocalhost:8205/actuator/health"] -.-> Service

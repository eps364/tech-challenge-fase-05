%% Domínio: Ação de Busca Ativa - SUS-Connect APS MVP (Fase 05)

classDiagram
    class SearchAction {
        +UUID id
        +UUID territoryId
        +PreventiveFocus focus
        +String objective
        +String responsibleTeam
        +LocalDate plannedStart
        +LocalDate plannedEnd
        +int targetCount
        +int performedCount
        +ActionStatus status
        +String notes
        +String resultNotes
        +LocalDateTime createdAt
        +LocalDateTime updatedAt
        +create(...) SearchAction$
        +reconstruct(...) SearchAction$
        +updateProgress(status, performedCount, resultNotes)
        +progressPercent() BigDecimal
        +isOverdue(Clock) boolean
    }

    class ActionStatus {
        <<enum>>
        PLANNED
        IN_PROGRESS
        COMPLETED
        CANCELLED
    }

    class PreventiveFocus {
        <<enum>>
        CHRONIC_CONDITIONS
        PRENATAL
        CHILD_VACCINATION
        CYTOPATHOLOGY
        +label() String
    }

    SearchAction --> ActionStatus : tem status
    SearchAction --> PreventiveFocus : foco preventivo
    note for SearchAction "COMPLETED exige performedCount > 0\nperformedCount nunca pode ser negativo\nplannedEnd não pode ser antes de plannedStart"

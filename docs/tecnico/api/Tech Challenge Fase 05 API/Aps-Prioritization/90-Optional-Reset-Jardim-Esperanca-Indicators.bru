meta {
  name: 90 - Opcional | resetar indicadores Jardim Esperanca
  type: http
  seq: 90
}

put {
  url: {{apsBaseUrl}}/territories/{{apsTerritoryId}}/indicators
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "linkedPopulationPercent": 42.00,
    "dataCompetence": "{{apsDemoCompetence}}",
    "indicators": [
      {"focus": "CHRONIC_CONDITIONS", "score": 32.00, "target": 60.00},
      {"focus": "PRENATAL_CARE", "score": 72.00, "target": 85.00}
    ]
  }
}
